From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] core: tear down static-mode tasks and per-CPU virtualization

Static mode returned after the last VM stopped without joining vCPU tasks or
disabling the per-CPU virtualization state.  It also discarded the handles of
the per-CPU initialization tasks.  Join all host tasks and disable hardware on
the same pinned CPUs before returning to the host.  This is host-neutral
lifecycle ordering and adds no substrate operation.
---
 virtualization/axvisor_core/src/boot.rs    | 56 ++++++++++++++++++++++------
 virtualization/axvisor_core/src/vmm/mod.rs |  7 ++++
 2 files changed, 52 insertions(+), 11 deletions(-)

diff --git a/virtualization/axvisor_core/src/boot.rs b/virtualization/axvisor_core/src/boot.rs
--- a/virtualization/axvisor_core/src/boot.rs
+++ b/virtualization/axvisor_core/src/boot.rs
@@ -11,7 +11,6 @@
 // limitations under the License.
 
-use alloc::format;
-use core::sync::atomic::{AtomicUsize, Ordering};
+use alloc::{format, vec::Vec};
 
 use axvisor_api::{
     host,
@@ -72,6 +71,8 @@ pub fn run_static_mode() {
     }
 
     run_static_vmm();
+    vmm::shutdown_static_mode();
+    disable_virtualization_on_all_cores();
 }
 
 fn init_runtime() -> ax_errno::AxResult {
@@ -126,8 +127,6 @@ fn ensure_hardware_support() {
 }
 
 fn enable_virtualization_on_all_cores() {
-    static CORES: AtomicUsize = AtomicUsize::new(0);
-
     info!("Enabling hardware virtualization support on all cores...");
 
     crate::arch::hardware_check();
@@ -135,7 +134,8 @@ fn enable_virtualization_on_all_cores() {
     let cpu_count = host::get_host_cpu_num();
 
+    let mut tasks = Vec::with_capacity(cpu_count);
     for cpu_id in 0..cpu_count {
-        task::spawn_task(
+        tasks.push(task::spawn_task(
             TaskOptions {
                 name: format!("axvisor-init-cpu-{cpu_id}"),
                 stack_size: CPU_INIT_TASK_STACK_SIZE,
@@ -161,16 +161,50 @@ fn enable_virtualization_on_all_cores() {
 
                 info!("Hardware virtualization support enabled on core {cpu_id}");
-
-                let _ = CORES.fetch_add(1, Ordering::Release);
             },
-        );
+        ));
     }
 
     info!("Waiting for all cores to enable hardware virtualization...");
+    for task in tasks {
+        task::join_task(task);
+    }
+    info!("All cores have enabled hardware virtualization support.");
+}
 
-    while CORES.load(Ordering::Acquire) != cpu_count {
-        axvisor_api::task::yield_now();
+fn disable_virtualization_on_all_cores() {
+    info!("Disabling hardware virtualization support on all cores...");
+
+    let cpu_count = host::get_host_cpu_num();
+    let mut tasks = Vec::with_capacity(cpu_count);
+    for cpu_id in 0..cpu_count {
+        tasks.push(task::spawn_task(
+            TaskOptions {
+                name: format!("axvisor-exit-cpu-{cpu_id}"),
+                stack_size: CPU_INIT_TASK_STACK_SIZE,
+                cpu_set: Some(1usize << cpu_id),
+            },
+            move || {
+                host::init_percpu();
+                info!("Disabling hardware virtualization support on core {cpu_id}");
+
+                // SAFETY: This closure is pinned to the target CPU and runs
+                // after every vCPU task has been joined.
+                #[allow(static_mut_refs)]
+                let percpu = unsafe { AXVM_PER_CPU.current_ref_mut_raw() };
+                if percpu.is_enabled() {
+                    percpu
+                        .hardware_disable()
+                        .expect("Failed to disable virtualization");
+                }
+
+                info!("Hardware virtualization support disabled on core {cpu_id}");
+            },
+        ));
+    }
+
+    for task in tasks {
+        task::join_task(task);
     }
 
-    info!("All cores have enabled hardware virtualization support.");
+    info!("All cores have disabled hardware virtualization support.");
 }
diff --git a/virtualization/axvisor_core/src/vmm/mod.rs b/virtualization/axvisor_core/src/vmm/mod.rs
--- a/virtualization/axvisor_core/src/vmm/mod.rs
+++ b/virtualization/axvisor_core/src/vmm/mod.rs
@@ -91,6 +91,13 @@ pub fn start() {
     });
 }
 
+/// Join and release every static VM's vCPU host tasks after all VMs stop.
+pub fn shutdown_static_mode() {
+    for vm in vm_list::get_vm_list() {
+        vcpus::cleanup_vm_vcpus(vm.id());
+    }
+}
+
 #[allow(unused_imports)]
 pub use vcpus::with_vcpu_task;
 
-- 
